rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Team emails
    function isTeamMember() {
      return isSignedIn() && request.auth.token.email in [
        'thanhnt.ads@gmail.com',
        'noithathoaphatdsg@gmail.com',
        'hoaphatnoithathm@gmail.com',
        'hoaphatnoithathn@gmail.com'
      ];
    }

    // Users: mọi signed-in user đọc/ghi doc của mình
    // Team member có thể đọc doc của nhau
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isTeamMember());
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    // Sources, items, accounts:
    // - Owner (ownerId == uid mình) đọc/ghi bình thường
    // - Team member đọc/ghi bất kỳ doc nào (vì họ dùng chung ownerId của owner)
    match /sources/{sourceId} {
      allow read: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isTeamMember());
      allow create: if isSignedIn() && (request.resource.data.ownerId == request.auth.uid || isTeamMember()) && request.resource.data.url is string;
      allow update: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isTeamMember());
      allow delete: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isTeamMember());
    }

    match /items/{itemId} {
      allow read: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isTeamMember());
      allow create: if isSignedIn() && (request.resource.data.ownerId == request.auth.uid || isTeamMember());
      allow update: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isTeamMember());
      allow delete: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isTeamMember());
    }

    match /accounts/{accountId} {
      allow read: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isTeamMember());
      allow create: if isSignedIn() && (request.resource.data.ownerId == request.auth.uid || isTeamMember());
      allow update: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isTeamMember());
      allow delete: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isTeamMember());
    }
  }
}
