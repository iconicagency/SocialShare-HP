rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    function isNewOwner() {
      return isSignedIn() && request.resource.data.ownerId == request.auth.uid;
    }

    // Users: any signed-in user can create/read/update their own doc
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // Sources
    match /sources/{sourceId} {
      allow read: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && isNewOwner() && request.resource.data.url is string;
      allow update: if isOwner() && isNewOwner();
      allow delete: if isOwner();
    }

    // Items
    match /items/{itemId} {
      allow read: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && isNewOwner();
      allow update: if isOwner() && isNewOwner();
      allow delete: if isOwner();
    }

    // Accounts
    match /accounts/{accountId} {
      allow read: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && isNewOwner();
      allow update: if isOwner() && isNewOwner();
      allow delete: if isOwner();
    }
  }
}
